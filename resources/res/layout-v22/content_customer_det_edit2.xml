<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/edit_cus_interface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_cash_interface"
            android:paddingTop="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="4">
            <TextView
                android:gravity="center"
                android:id="@+id/tv_cash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fund_account_name"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tr_curr_price"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/fund_account_name"/>
        </LinearLayout>
        <View
            android:id="@+id/primerdivisor1"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="10"
            android:layout_centerHorizontal="true">
            <ImageView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_gravity="center"
                android:id="@+id/btn_calc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/calculator"
                android:text="@string/btn_calc"
                android:layout_weight="1"
                android:onClick="calc_pick_btn"
                android:contextClickable="false"/>
            <EditText
                android:gravity="center_horizontal"
                android:id="@+id/edit_tr_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/tr_amount"
                android:singleLine="true"
                android:layout_weight="3"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"/>
            <AutoCompleteTextView
                android:gravity="center_horizontal"
                android:id="@+id/cus_name_det"
                android:nextFocusLeft="@+id/edit_tr_amount"
                android:nextFocusRight="@+id/edit_tr_amount"
                android:nextFocusUp="@+id/edit_tr_amount"
                android:nextFocusDown="@+id/edit_tr_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/cus_name"
                android:singleLine="true"
                android:layout_weight="6"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/edit_tr_amount"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/LL_discount"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">
            <TextView
                android:gravity="top|center_horizontal"
                android:id="@+id/disc_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/disc_title"
                android:onClick="update_disc_amount"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="10"
            android:layout_centerHorizontal="true">
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/edit_tr_date"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:hint="2017-01-01"
                android:editable="false"
                android:layout_weight="3"
                android:inputType="date"
                android:contextClickable="true"/>
            <RadioGroup
                android:gravity="center"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:id="@+id/radiogroup1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7">
                <RadioButton
                    android:id="@+id/radiobutton1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/radio1"/>
                <RadioButton
                    android:id="@+id/radiobutton2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/radio2"/>
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:gravity="top"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="10">
            <Button
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/btn_cus_det_edit"
                android:background="@drawable/my_border"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:text="@string/btn_add"
                android:layout_weight="2"
                android:layout_below="@+id/edit_cus_gsm"
                android:layout_alignParentLeft="true"
                android:onClick="btn_cus_save"
                android:layout_alignParentStart="true"
                android:contextClickable="false"/>
            <ImageView
                android:gravity="top"
                android:layout_gravity="top"
                android:id="@+id/btn_attach"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/camera"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"/>
            <AutoCompleteTextView
                android:gravity="top|center_horizontal"
                android:layout_gravity="end"
                android:id="@+id/edit_tr_remarks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/tr_remarks"
                android:singleLine="true"
                android:layout_weight="8"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="top"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="10">
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/edit_tr_date4"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="2017-01-01"
                android:editable="false"
                android:layout_weight="3"
                android:inputType="date"
                android:contextClickable="true"/>
            <ImageView
                android:textColor="@android:color/white"
                android:gravity="top"
                android:layout_gravity="top"
                android:id="@+id/btn_attach4"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:src="@drawable/camera"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"/>
            <AutoCompleteTextView
                android:gravity="center"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/edit_tr_remarks4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/tr_remarks"
                android:singleLine="true"
                android:layout_weight="7"/>
        </LinearLayout>
        <HorizontalScrollView
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/horiz_curr_list"
            android:scrollbars="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/edit_cus_interface_curr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:gravity="start"
                    android:layout_gravity="start"
                    android:orientation="horizontal"
                    android:id="@+id/radiogroup_curr"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface5"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="10"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/edit_cus_interface5_1"
                android:paddingLeft="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:layout_centerHorizontal="true"
                android:paddingStart="10dp">
                <Button
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_cus_det_add1"
                    android:background="@drawable/my_border"
                    android:paddingLeft="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="@string/radio1"
                    android:drawableLeft="@drawable/up"
                    android:layout_below="@+id/edit_cus_gsm"
                    android:onClick="btn_cus_add"
                    android:drawableStart="@drawable/up"
                    android:paddingStart="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/edit_cus_interface5_2"
                android:paddingLeft="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:layout_centerHorizontal="true"
                android:paddingStart="10dp">
                <Button
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_cus_det_add2"
                    android:background="@drawable/my_border"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="@string/radio2"
                    android:drawableLeft="@drawable/down"
                    android:layout_below="@+id/edit_cus_gsm"
                    android:onClick="btn_cus_add"
                    android:drawableStart="@drawable/down"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ListView
        android:id="@+id/list_cus_det_edit"
        android:animationCache="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="#00000000"
        android:drawSelectorOnTop="false"
        android:scrollingCache="false"
        android:dividerHeight="0dp"
        android:layout_below="@+id/edit_cus_interface"
        android:smoothScrollbar="true"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#536fd2"
        android:textColorHighlight="#ffffff"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/emptyResults"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/empty_list"
        android:layout_below="@+id/list_cus_det_edit"/>
</RelativeLayout>
