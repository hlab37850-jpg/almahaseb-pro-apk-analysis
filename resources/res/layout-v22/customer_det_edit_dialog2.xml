<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/edit_cus_interface"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">
        <View
            android:id="@+id/primerdivisor1"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface1"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="10"
            android:layout_centerHorizontal="true">
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/edit_tr_date"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:hint="@string/tr_date"
                android:editable="false"
                android:layout_weight="4"
                android:inputType="date"
                android:contextClickable="true"/>
            <ImageView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_gravity="center"
                android:id="@+id/btn_calc"
                android:paddingRight="5dp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/calculator"
                android:text="@string/btn_calc"
                android:paddingEnd="5dp"
                android:contextClickable="false"/>
            <EditText
                android:gravity="center_horizontal"
                android:id="@+id/edit_tr_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/tr_amount"
                android:singleLine="true"
                android:layout_weight="6"
                android:inputType="numberDecimal"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface2"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="10">
            <ImageView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="start|center_vertical"
                android:id="@+id/btn_attach"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/camera"
                android:contextClickable="false"/>
            <AutoCompleteTextView
                android:gravity="center_horizontal"
                android:layout_gravity="end"
                android:id="@+id/edit_tr_remarks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/tr_remarks"
                android:singleLine="true"
                android:layout_weight="10"/>
        </LinearLayout>
        <HorizontalScrollView
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/horiz_curr_list"
            android:scrollbars="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/edit_cus_interface_curr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:gravity="start"
                    android:layout_gravity="start"
                    android:orientation="horizontal"
                    android:id="@+id/radiogroup_curr"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface3_1"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="10"
            android:layout_centerHorizontal="true">
            <View
                android:id="@+id/primerdivisor_5"
                android:background="@android:color/darker_gray"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface3"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="10"
            android:layout_centerHorizontal="true">
            <Button
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_gravity="start"
                android:id="@+id/btn_cus_det_edit"
                android:background="@drawable/my_border"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:text="@string/btn_add"
                android:layout_weight="2"
                android:layout_below="@+id/edit_cus_gsm"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:contextClickable="false"/>
            <RadioGroup
                android:gravity="center"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:id="@+id/radiogroup1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7">
                <RadioButton
                    android:id="@+id/radiobutton1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/radio1"/>
                <RadioButton
                    android:id="@+id/radiobutton2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/radio2"/>
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface5"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="10"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/edit_cus_interface5_1"
                android:paddingLeft="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:layout_centerHorizontal="true"
                android:paddingStart="10dp">
                <Button
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_cus_det_add1"
                    android:background="@drawable/my_border"
                    android:paddingLeft="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="@string/radio1"
                    android:drawableLeft="@drawable/up"
                    android:layout_below="@+id/edit_cus_gsm"
                    android:drawableStart="@drawable/up"
                    android:paddingStart="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/edit_cus_interface5_2"
                android:paddingLeft="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:layout_centerHorizontal="true"
                android:paddingStart="10dp">
                <Button
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_cus_det_add2"
                    android:background="@drawable/my_border"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="@string/radio2"
                    android:drawableLeft="@drawable/down"
                    android:layout_below="@+id/edit_cus_gsm"
                    android:drawableStart="@drawable/down"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
