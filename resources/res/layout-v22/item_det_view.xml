<?xml version="1.0" encoding="utf-8"?>
<androidx.percentlayout.widget.PercentRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/primerdivisor1"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="top|right"
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="top|right"
                android:id="@+id/desc_det"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/empty_list"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"/>
            <TextView
                android:gravity="top|right"
                android:id="@+id/desc_hdr"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/empty_list"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"/>
        </LinearLayout>
        <ImageView
            android:gravity="top"
            android:layout_gravity="center"
            android:id="@+id/btn_attach"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/camera"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
    </LinearLayout>
    <View
        android:id="@+id/primerdivisor2"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</androidx.percentlayout.widget.PercentRelativeLayout>
