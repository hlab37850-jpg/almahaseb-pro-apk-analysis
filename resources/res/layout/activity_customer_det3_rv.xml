<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/edit_cus_interface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="100">
    <LinearLayout
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/edit_cus_header"
        android:background="@color/bk_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2">
        <include
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/report_hdr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/customer_det_row3"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/edit_cus_list_det"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="95"
        android:layout_below="@+id/edit_cus_header"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textColor="@color/text_color"
            android:textColorHighlight="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@android:id/empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_list"/>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/activity_main_swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@android:id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/edit_cus_interface3"
        android:background="@drawable/table_row_bg_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:layout_below="@+id/edit_cus_list_det">
        <include
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/report_hdr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/footer_bal3_2_"/>
    </LinearLayout>
</LinearLayout>
