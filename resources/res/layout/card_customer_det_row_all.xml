<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="0dp"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="1dp"
        app:cardElevation="1dp"
        app:cardUseCompatPadding="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_card"
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="110"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/img"
                android:clickable="false"
                android:duplicateParentState="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10"/>
            <TextView
                android:id="@+id/tr_id"
                android:visibility="invisible"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:text="TR_ID"
                android:layout_toRightOf="@+id/img"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@+id/img"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tr_remarks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/tr_remarks"
                android:layout_weight="28"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tr_amount"
                android:paddingRight="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/tr_amount"
                android:layout_weight="20"
                android:paddingEnd="5dp"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tr_name"
                android:paddingRight="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cus_name"
                android:layout_weight="23"
                android:paddingEnd="5dp"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tr_date"
                android:paddingRight="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/tr_date"
                android:layout_weight="29"
                android:paddingEnd="2dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
