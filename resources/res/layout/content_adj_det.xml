<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:padding="1dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:background="@drawable/table_row_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/content_bill_del_p1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/content_adj_det_p1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/tr_item_add_hdr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            layout="@layout/content_bill_item_add_hdr"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/report_hdr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            layout="@layout/bill_item_det_row_hdr_"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/lv_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list_items"
            android:animationCache="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="#00000000"
            android:drawSelectorOnTop="false"
            android:scrollingCache="false"
            android:dividerHeight="0dp"
            android:smoothScrollbar="true"
            android:isScrollContainer="false"/>
    </LinearLayout>
    <LinearLayout
        android:background="@drawable/table_row_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="125">
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tr_tot"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="0"
                android:layout_weight="50"
                android:onClick="update_bill_total"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/bill_tot_hdr"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/total_cost"
                android:layout_weight="55"
                android:onClick="update_bill_total"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
