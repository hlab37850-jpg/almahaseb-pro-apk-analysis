<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/item_add_hdr"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/primerdivisor4"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="center"
                android:id="@+id/item_barcode_col_cnt"
                android:background="@drawable/table_row_bg"
                android:padding="10dp"
                android:nextFocusLeft="@+id/item_barcode_img_cnt"
                android:nextFocusRight="@+id/item_barcode_img_cnt"
                android:nextFocusUp="@+id/item_barcode_img_cnt"
                android:nextFocusDown="@+id/item_barcode_img_cnt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/item_barcode_img_cnt"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_row_cnt"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/barcode_img_row_cnt"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="center"
                android:id="@+id/item_barcode_img_cnt"
                android:background="@drawable/table_row_bg"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="number"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_qty_hdr"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/barcode_img_cnt"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="right"
                android:id="@+id/ll_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="center"
                    android:id="@+id/name_hdr"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/name"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_compat3"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:checked="false"
                    android:textOn="ON"
                    android:textOff="OFF"
                    app:showText="false"/>
            </LinearLayout>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/tv_curr"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/currency"
                    android:drawableLeft="@drawable/list2"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/item_status_hdr"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/price"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_compat"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:checked="false"
                    android:textOn="ON"
                    android:textOff="OFF"
                    app:showText="false"/>
            </LinearLayout>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/base_unit_status_hdr"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/base_unit"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_compat2"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:checked="false"
                        android:textOn="ON"
                        android:textOff="OFF"
                        app:showText="false"/>
                </LinearLayout>
            </LinearLayout>
        </TableRow>
        <View
            android:id="@+id/primerdivisor3"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </TableLayout>
</LinearLayout>
