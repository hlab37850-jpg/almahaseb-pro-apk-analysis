<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/item_add_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="center"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <AutoCompleteTextView
                    android:gravity="center"
                    android:id="@+id/item_name"
                    android:background="@drawable/table_row_bg5"
                    android:paddingRight="2dp"
                    android:nextFocusLeft="@+id/item_qty"
                    android:nextFocusRight="@+id/item_qty"
                    android:nextFocusUp="@+id/item_qty"
                    android:nextFocusDown="@+id/item_qty"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:hint="@string/item_name"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@+id/item_qty">
                    <requestFocus/>
                </AutoCompleteTextView>
                <LinearLayout
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/item_name_hdr"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_column="1"
                        android:text="@string/item"
                        android:drawableLeft="@drawable/about2"
                        android:onClick="view_item_info2"/>
                </LinearLayout>
            </LinearLayout>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="center"
                android:id="@+id/item_barcode"
                android:nextFocusLeft="@+id/item_price"
                android:nextFocusRight="@+id/item_price"
                android:nextFocusUp="@+id/item_price"
                android:nextFocusDown="@+id/item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/barcode_no"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/item_price"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_qty_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/barcode_no"/>
        </TableRow>
        <View
            android:id="@+id/primerdivisor3"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </TableLayout>
</LinearLayout>
