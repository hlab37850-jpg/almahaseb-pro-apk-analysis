<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4">
        <TextView
            android:gravity="center"
            android:id="@+id/tr_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="2018-01-01"
            android:layout_weight="1"/>
        <AutoCompleteTextView
            android:gravity="right"
            android:id="@+id/tr_name"
            android:nextFocusLeft="@+id/tr_bill_no"
            android:nextFocusRight="@+id/tr_bill_no"
            android:nextFocusUp="@+id/tr_bill_no"
            android:nextFocusDown="@+id/tr_bill_no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:hint="@string/branch_name"
            android:singleLine="true"
            android:layout_weight="3"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_bill_no">
            <requestFocus/>
        </AutoCompleteTextView>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1">
        <ImageView
            android:gravity="center"
            android:id="@+id/adj_list"
            android:background="@drawable/list4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="adj_list"/>
        <AutoCompleteTextView
            android:gravity="right"
            android:id="@+id/to_tr_name"
            android:nextFocusLeft="@+id/tr_bill_no"
            android:nextFocusRight="@+id/tr_bill_no"
            android:nextFocusUp="@+id/tr_bill_no"
            android:nextFocusDown="@+id/tr_bill_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/adj_type"
            android:singleLine="true"
            android:layout_weight="1"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_bill_no">
            <requestFocus/>
        </AutoCompleteTextView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface_curr"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:gravity="start"
            android:layout_gravity="start"
            android:orientation="horizontal"
            android:id="@+id/radiogroup_curr"
            android:background="@drawable/table_row_bg6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4">
        <EditText
            android:gravity="right"
            android:id="@+id/tr_remaks"
            android:nextFocusLeft="@+id/item_name"
            android:nextFocusRight="@+id/item_name"
            android:nextFocusUp="@+id/item_name"
            android:nextFocusDown="@+id/item_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/tr_remarks"
            android:singleLine="true"
            android:layout_weight="3"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/item_name"/>
        <EditText
            android:gravity="right"
            android:id="@+id/tr_bill_no"
            android:nextFocusLeft="@+id/tr_remaks"
            android:nextFocusRight="@+id/tr_remaks"
            android:nextFocusUp="@+id/tr_remaks"
            android:nextFocusDown="@+id/tr_remaks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/bill_no"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="number"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_remaks"/>
    </LinearLayout>
</LinearLayout>
