<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="100"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/bill_add_item_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/tr_item_add_hdr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                layout="@layout/content_bill_item_add"/>
        </TableRow>
    </TableLayout>
    <TableLayout
        android:id="@+id/bill_det"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/report_hdr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                layout="@layout/bill_item_det_row_hdr"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:background="@drawable/table_row_bg2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ListView
                android:gravity="right"
                android:id="@+id/list_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </TableRow>
    </TableLayout>
    <TableLayout
        android:id="@+id/bill_add_remark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TableLayout
        android:id="@+id/bill_add_item_sum"
        android:background="@drawable/table_row_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="125">
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tr_tot"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="0"
                android:layout_weight="50"
                android:onClick="update_bill_total"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/bill_tot_hdr"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/total"
                android:layout_weight="55"
                android:onClick="update_bill_total"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
