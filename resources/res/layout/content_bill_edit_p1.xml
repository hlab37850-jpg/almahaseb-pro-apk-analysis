<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:id="@+id/bill_edit_hdr"
    android:background="@drawable/table_row_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <include layout="@layout/include_bill_status"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/row1"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <LinearLayout
            android:gravity="left"
            android:id="@+id/row1_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="100">
            <CheckBox
                android:id="@+id/chk_back"
                android:paddingRight="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/bill_back"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tr_branch"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/branch"
                android:singleLine="true"
                android:drawableLeft="@drawable/list2"
                android:layout_weight="50"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/item_status_hdr"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/bill_cash"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_compat"
            android:paddingRight="10dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:checked="false"
            android:textOn="ON"
            android:textOff="OFF"
            app:showText="false"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4">
        <ImageView
            android:gravity="center"
            android:id="@+id/img_u_currency"
            android:background="@drawable/s_currency2"
            android:visibility="visible"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
        <TextView
            android:textStyle="bold"
            android:gravity="right"
            android:id="@+id/tv_curr"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/currency"
            android:drawableRight="@drawable/list2"
            android:layout_weight="2.25"/>
        <TextView
            android:gravity="right"
            android:id="@+id/tv_cash"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cash_account_name"
            android:drawableLeft="@drawable/list2"
            android:layout_weight="1.75"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4">
        <TextView
            android:gravity="center"
            android:id="@+id/tr_date"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="2018-01-01"/>
        <AutoCompleteTextView
            android:gravity="right"
            android:id="@+id/tr_name"
            android:nextFocusLeft="@+id/tr_bill_no"
            android:nextFocusRight="@+id/tr_bill_no"
            android:nextFocusUp="@+id/tr_bill_no"
            android:nextFocusDown="@+id/tr_bill_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/name"
            android:singleLine="true"
            android:layout_weight="4"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_bill_no">
            <requestFocus/>
        </AutoCompleteTextView>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3">
        <ImageView
            android:textColor="@android:color/white"
            android:gravity="top"
            android:layout_gravity="top"
            android:id="@+id/btn_attach"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:src="@drawable/camera"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <EditText
            android:gravity="right"
            android:id="@+id/tr_remaks"
            android:nextFocusLeft="@+id/item_name"
            android:nextFocusRight="@+id/item_name"
            android:nextFocusUp="@+id/item_name"
            android:nextFocusDown="@+id/item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/tr_remarks"
            android:singleLine="true"
            android:layout_weight="2"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/item_name"/>
        <EditText
            android:gravity="right"
            android:id="@+id/tr_bill_no"
            android:nextFocusLeft="@+id/tr_remaks"
            android:nextFocusRight="@+id/tr_remaks"
            android:nextFocusUp="@+id/tr_remaks"
            android:nextFocusDown="@+id/tr_remaks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/bill_no"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="number"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_remaks"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:gravity="right"
            android:id="@+id/tr_price_diff"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="@string/tr_price_dii"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"/>
    </LinearLayout>
</LinearLayout>
