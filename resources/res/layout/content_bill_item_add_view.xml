<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/item_add_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1">
        <View
            android:id="@+id/primerdivisor3_"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:gravity="center"
                    android:id="@+id/tr_item_barcode2"
                    android:background="@drawable/barcode"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="barcode_click"/>
                <AutoCompleteTextView
                    android:gravity="center"
                    android:id="@+id/item_name"
                    android:tag="2"
                    android:background="@drawable/table_row_bg5"
                    android:paddingRight="2dp"
                    android:nextFocusLeft="@+id/item_qty"
                    android:nextFocusRight="@+id/item_qty"
                    android:nextFocusUp="@+id/item_qty"
                    android:nextFocusDown="@+id/item_qty"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:hint="@string/item_name"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@+id/item_qty">
                    <requestFocus/>
                </AutoCompleteTextView>
                <ImageView
                    android:gravity="center"
                    android:id="@+id/img_add_amount"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/about2"/>
                <LinearLayout
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/item_name_hdr"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_column="1"
                        android:text="@string/item"
                        android:drawableLeft="@drawable/about2"
                        android:onClick="view_item_info2"/>
                </LinearLayout>
            </LinearLayout>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:paddingLeft="1dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="5"
                android:layout_weight="1">
                <TextView
                    android:gravity="center"
                    android:id="@+id/item_date"
                    android:paddingRight="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="@string/end_date"
                    android:drawableLeft="@drawable/calendar2"
                    android:drawableStart="@drawable/calendar2"/>
                <EditText
                    android:gravity="center"
                    android:id="@+id/item_qty"
                    android:nextFocusLeft="@+id/item_price"
                    android:nextFocusRight="@+id/item_price"
                    android:nextFocusUp="@+id/item_price"
                    android:nextFocusDown="@+id/item_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="0"
                    android:singleLine="true"
                    android:drawableLeft="@drawable/power2"
                    android:layout_weight="5"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@+id/item_price"
                    android:drawableStart="@drawable/power2"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/item_qty_hdr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qty"/>
            </LinearLayout>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="center"
                android:id="@+id/item_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:drawableLeft="@drawable/power2"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:drawableStart="@drawable/power2"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_price_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="center"
                android:id="@+id/item_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:drawableLeft="@drawable/calculator"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:drawableStart="@drawable/calculator"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_total_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/item_total_or"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:paddingLeft="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="5"
                android:layout_weight="1">
                <AutoCompleteTextView
                    android:gravity="center"
                    android:id="@+id/item_remarks"
                    android:background="@drawable/table_row_bg5"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:hint="@string/item_remarks_hint"
                    android:singleLine="true"
                    android:layout_weight="4"
                    android:inputType="text"
                    android:imeOptions="actionDone"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/item_unit"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit"
                    android:layout_weight="1"/>
            </LinearLayout>
        </TableRow>
        <View
            android:id="@+id/primerdivisor3"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </TableLayout>
</LinearLayout>
