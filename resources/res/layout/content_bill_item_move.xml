<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/item_add_hdr"
        android:background="@drawable/table_row_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <AutoCompleteTextView
                android:gravity="right"
                android:id="@+id/item_name"
                android:nextFocusLeft="@+id/item_qty"
                android:nextFocusRight="@+id/item_qty"
                android:nextFocusUp="@+id/item_qty"
                android:nextFocusDown="@+id/item_qty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/item_name"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/item_qty">
                <requestFocus/>
            </AutoCompleteTextView>
            <TextView
                android:id="@+id/item_name_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="@string/item"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="center"
                android:id="@+id/item_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_qty_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qty"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:id="@+id/item_weight"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_weight_hdr"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weight"/>
        </TableRow>
        <View
            android:id="@+id/primerdivisor3"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <TableRow
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:padding="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="100">
                <LinearLayout
                    android:gravity="left"
                    android:paddingLeft="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="50">
                    <ImageView
                        android:gravity="center"
                        android:id="@+id/tr_item_close"
                        android:background="@drawable/ic_hide_item"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:onClick="btn_item_hide"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="50">
                    <ImageView
                        android:gravity="center"
                        android:id="@+id/tr_item_add"
                        android:background="@drawable/ic_add_item"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:onClick="add_item"/>
                </LinearLayout>
            </LinearLayout>
        </TableRow>
    </TableLayout>
</LinearLayout>
