<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/item_add_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/primerdivisor3_"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <TextView
                    android:gravity="center"
                    android:id="@+id/item_status_hdr"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_column="1"
                    android:text="@string/bill_post"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_compat"
                    android:paddingRight="10dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:checked="false"
                    android:textOn="ON"
                    android:textOff="OFF"
                    app:showText="false"/>
            </LinearLayout>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <AutoCompleteTextView
                android:gravity="right"
                android:id="@+id/p_tr_name"
                android:nextFocusLeft="@+id/item_qty"
                android:nextFocusRight="@+id/item_qty"
                android:nextFocusUp="@+id/item_qty"
                android:nextFocusDown="@+id/item_qty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/supp"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/item_qty">
                <requestFocus/>
            </AutoCompleteTextView>
            <TextView
                android:id="@+id/p_tr_name_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="@string/supp"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="center"
                android:id="@+id/tr_date_p"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="2018-01-01"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/p_tr_date_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="@string/date"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="right"
                android:id="@+id/item_name"
                android:padding="5dp"
                android:nextFocusLeft="@+id/item_qty"
                android:nextFocusRight="@+id/item_qty"
                android:nextFocusUp="@+id/item_qty"
                android:nextFocusDown="@+id/item_qty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/item_name"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/item_qty">
                <requestFocus/>
            </TextView>
            <TextView
                android:id="@+id/item_name_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="@string/item"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="center"
                android:id="@+id/item_qty"
                android:nextFocusLeft="@+id/item_price"
                android:nextFocusRight="@+id/item_price"
                android:nextFocusUp="@+id/item_price"
                android:nextFocusDown="@+id/item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:drawableLeft="@drawable/power"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/item_price"
                android:drawableStart="@drawable/power"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_qty_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qty"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="center"
                android:id="@+id/item_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:drawableLeft="@drawable/power"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:drawableStart="@drawable/power"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_price_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_unit"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="center"
                android:id="@+id/item_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:drawableLeft="@drawable/power"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:drawableStart="@drawable/power"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_total_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/item_total_or"/>
        </TableRow>
        <View
            android:id="@+id/primerdivisor3"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </TableLayout>
</LinearLayout>
