<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/item_add_hdr"
        android:background="@drawable/table_row_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/item_qty"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/item_qty_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/available_qty"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/item_price"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:editable="false"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/item_price_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sales_price"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/item_total"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:editable="false"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/item_total_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/purchase_price"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/item_last_price"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:editable="false"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/item_last_price_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/last_cus_price"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:gravity="top|center_horizontal"
                    android:layout_gravity="center"
                    android:id="@+id/btn_attach"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/camera"
                    android:layout_weight="1"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/item_remarks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:inputType="numberDecimal"/>
            </LinearLayout>
        </TableRow>
    </TableLayout>
</LinearLayout>
