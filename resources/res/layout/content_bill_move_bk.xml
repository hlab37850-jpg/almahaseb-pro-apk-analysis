<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="100"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/bill_hdr"
        android:background="@drawable/table_row_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="5">
            <TextView
                android:gravity="center"
                android:id="@+id/tr_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="2018-01-01"
                android:layout_weight="2"/>
            <AutoCompleteTextView
                android:gravity="right"
                android:id="@+id/tr_name"
                android:nextFocusLeft="@+id/to_tr_name"
                android:nextFocusRight="@+id/to_tr_name"
                android:nextFocusUp="@+id/to_tr_name"
                android:nextFocusDown="@+id/to_tr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:hint="@string/from_branch"
                android:singleLine="true"
                android:layout_weight="3"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/to_tr_name">
                <requestFocus/>
            </AutoCompleteTextView>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <AutoCompleteTextView
                android:gravity="right"
                android:id="@+id/to_tr_name"
                android:nextFocusLeft="@+id/tr_bill_no"
                android:nextFocusRight="@+id/tr_bill_no"
                android:nextFocusUp="@+id/tr_bill_no"
                android:nextFocusDown="@+id/tr_bill_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/to_branch"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/tr_bill_no">
                <requestFocus/>
            </AutoCompleteTextView>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TableLayout
                android:id="@+id/bill_add_item_sub_hdr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TableRow
                    android:gravity="center_horizontal"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:gravity="center"
                        android:id="@+id/tr_name_add"
                        android:background="@drawable/choose"
                        android:visibility="gone"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:hint="@string/btn_add"/>
                </TableRow>
            </TableLayout>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="right"
                android:id="@+id/tr_remaks"
                android:nextFocusLeft="@+id/item_name"
                android:nextFocusRight="@+id/item_name"
                android:nextFocusUp="@+id/item_name"
                android:nextFocusDown="@+id/item_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/tr_remarks"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/item_name"/>
            <EditText
                android:gravity="right"
                android:id="@+id/tr_bill_no"
                android:nextFocusLeft="@+id/tr_remaks"
                android:nextFocusRight="@+id/tr_remaks"
                android:nextFocusUp="@+id/tr_remaks"
                android:nextFocusDown="@+id/tr_remaks"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:hint="@string/bill_no"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/tr_remaks"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="right"
                android:id="@+id/tr_price_diff"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/tr_price_dii"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"/>
        </TableRow>
    </TableLayout>
    <TableLayout
        android:id="@+id/bill_add_item_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/tr_item_add_hdr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                layout="@layout/content_bill_item_move"/>
        </TableRow>
    </TableLayout>
    <TableLayout
        android:id="@+id/bill_det"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/report_hdr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                layout="@layout/move_item_det_row_hdr"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:background="@drawable/table_row_bg2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ListView
                android:gravity="right"
                android:id="@+id/list_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </TableRow>
    </TableLayout>
    <TableLayout
        android:id="@+id/bill_add_remark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TableLayout
        android:id="@+id/bill_add_item_sum"
        android:background="@drawable/table_row_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="125">
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tr_tot"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="0"
                android:layout_weight="50"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/bill_tot_hdr"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/total_qty"
                android:layout_weight="55"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
