<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/item_add_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/primerdivisor3_"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioGroup
                android:gravity="center"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:id="@+id/radiogroup1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RadioButton
                    android:id="@+id/radiobutton2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نسبة"/>
                <RadioButton
                    android:id="@+id/radiobutton1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="مبلغ"/>
            </RadioGroup>
            <EditText
                android:gravity="center"
                android:id="@+id/bill_disc_amt"
                android:background="@drawable/table_row_bg5"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:hint="0"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_qty_hdr"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/total_disc2"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:id="@+id/ll_tax"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:gravity="center"
                android:id="@+id/bill_tax_amount"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="0"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tr_tax_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:drawableLeft="@drawable/list2"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_price_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_tax2"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:id="@+id/ll_cost"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <AutoCompleteTextView
                android:gravity="right"
                android:id="@+id/cost_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/cost_account"
                android:singleLine="true"
                android:layout_weight="1">
                <requestFocus/>
            </AutoCompleteTextView>
            <EditText
                android:gravity="center"
                android:id="@+id/bill_other_cost"
                android:background="@drawable/table_row_bg5"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text=""
                android:hint="@string/total_other_cost"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_total_hdr"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="@string/total_other_cost"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:id="@+id/ll_paid_amount"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:id="@+id/empty_tv"
                android:padding="5dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paid_amount"
                android:layout_weight="1"/>
            <EditText
                android:gravity="center"
                android:id="@+id/paid_amount"
                android:background="@drawable/table_row_bg5"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text=""
                android:hint="@string/paid_amount"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_unit"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paid_amount"/>
        </TableRow>
        <View
            android:id="@+id/primerdivisor3"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </TableLayout>
</LinearLayout>
