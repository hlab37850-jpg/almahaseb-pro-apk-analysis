<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/edit_cus_interface_containter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="110">
            <LinearLayout
                android:gravity="top"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/main_rows"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="100">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/main_row_1"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <GridView
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/gridview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:horizontalSpacing="10dp"
                        android:verticalSpacing="10dp"
                        android:stretchMode="columnWidth"
                        android:numColumns="2"
                        android:layout_centerInParent="true"
                        android:layout_centerHorizontal="true"/>
                </LinearLayout>
                <View
                    android:id="@+id/primerdivisor_2"
                    android:background="@android:color/darker_gray"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/list_report"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/main_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ExpandableListView
                        android:id="@+id/list_report"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:groupIndicator="@null"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/edit_cus_interface3"
                android:background="@color/gold"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="10">
                <View
                    android:id="@+id/primerdivisor_3"
                    android:background="@android:color/darker_gray"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/list_report"/>
                <include
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/report_hdr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/footer_bal_m"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>
