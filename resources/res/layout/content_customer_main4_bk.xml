<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:id="@+id/edit_cus_interface_containter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="100">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/edit_cus_interface_containter2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="100">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/main_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="50">
                    <GridView
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/gridview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:horizontalSpacing="10dp"
                        android:verticalSpacing="10dp"
                        android:stretchMode="columnWidth"
                        android:numColumns="2"
                        android:layout_centerHorizontal="true"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/main_row_2"
                    android:background="@color/gold"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="50">
                    <GridView
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/gridview2"
                        android:background="@color/gold"
                        android:paddingTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:horizontalSpacing="10dp"
                        android:verticalSpacing="10dp"
                        android:stretchMode="columnWidth"
                        android:numColumns="3"
                        android:layout_centerInParent="true"
                        android:layout_centerHorizontal="true"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/edit_cus_interface3"
                android:background="@color/gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/report_hdr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/footer_bal_m"/>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:src="@drawable/add3"
            android:scaleType="center"
            app:backgroundTint="@android:color/transparent"
            app:borderWidth="0dp"
            app:fabSize="mini"
            app:layout_anchor="@+id/main_row_1"
            app:layout_anchorGravity="end|bottom"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>
