<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/edit_cus_interface_containter"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="100">
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/cus_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="98"
        android:layout_below="@+id/cus_search"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/activity_main_swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ListView
                android:id="@+id/list_data"
                android:animationCache="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:listSelector="#00000000"
                android:drawSelectorOnTop="false"
                android:scrollingCache="false"
                android:dividerHeight="0dp"
                android:smoothScrollbar="true"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <View
            android:id="@+id/primerdivisor"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@+id/list_data"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#536fd2"
            android:textColorHighlight="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/emptyResults"
            android:background="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_results"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/cus_footer"
        android:background="@drawable/table_row_bg_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:layout_below="@+id/cus_list">
        <include
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/report_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/footer_bal_m_2"/>
    </LinearLayout>
</LinearLayout>
