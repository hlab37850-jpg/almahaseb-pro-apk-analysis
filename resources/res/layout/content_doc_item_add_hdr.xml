<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/item_add_hdr"
        android:background="@drawable/table_row_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:gravity="center"
                android:id="@+id/img_fwd_amount"
                android:background="@drawable/tran6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <AutoCompleteTextView
                android:gravity="center"
                android:id="@+id/item_name"
                android:nextFocusLeft="@+id/item_qty"
                android:nextFocusRight="@+id/item_qty"
                android:nextFocusUp="@+id/item_qty"
                android:nextFocusDown="@+id/item_qty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/add_account_hdr"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/item_qty">
                <requestFocus/>
            </AutoCompleteTextView>
            <ImageView
                android:gravity="center"
                android:id="@+id/tr_item_add"
                android:background="@drawable/ic_add_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="add_item"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
