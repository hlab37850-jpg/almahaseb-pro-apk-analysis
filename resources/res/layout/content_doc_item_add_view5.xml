<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/edit_cus_interface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">
    <AutoCompleteTextView
        android:gravity="center_horizontal"
        android:id="@+id/cus_name_det"
        android:nextFocusLeft="@+id/edit_tr_amount"
        android:nextFocusRight="@+id/edit_tr_amount"
        android:nextFocusUp="@+id/edit_tr_amount"
        android:nextFocusDown="@+id/edit_tr_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/account_name"
        android:singleLine="true"
        android:layout_weight="6"
        android:imeOptions="actionNext"
        android:nextFocusForward="@+id/edit_tr_amount"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="10"
        android:layout_centerHorizontal="true">
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/edit_tr_date"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:hint="@string/tr_date"
            android:inputType="date"
            android:paddingEnd="5dp"/>
        <ImageView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:id="@+id/btn_calc"
            android:paddingRight="5dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/calculator"
            android:text="@string/btn_calc"
            android:onClick="calc_pick_btn"
            android:paddingEnd="5dp"/>
        <EditText
            android:gravity="center_horizontal"
            android:id="@+id/edit_tr_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/tr_amount"
            android:singleLine="true"
            android:layout_weight="10"
            android:inputType="numberDecimal">
            <requestFocus/>
        </EditText>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="10"
        android:layout_centerHorizontal="true">
        <RadioGroup
            android:gravity="center"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:id="@+id/radiogroup1"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="10">
            <RadioButton
                android:id="@+id/radiobutton1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/radio1"/>
            <RadioButton
                android:id="@+id/radiobutton2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/radio2"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout
        android:gravity="top"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="10">
        <ImageView
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_attach"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/camera"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <AutoCompleteTextView
            android:gravity="top|center_horizontal"
            android:layout_gravity="end"
            android:id="@+id/edit_tr_remarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/tr_remarks"
            android:singleLine="true"
            android:layout_weight="10"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="top"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="10">
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/edit_tr_date4"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="2017-01-01"
            android:layout_weight="3"
            android:inputType="date"/>
        <ImageView
            android:textColor="@android:color/white"
            android:gravity="top"
            android:layout_gravity="top"
            android:id="@+id/btn_attach4"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:src="@drawable/camera"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/edit_tr_remarks4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/tr_remarks"
            android:singleLine="true"
            android:layout_weight="10"/>
    </LinearLayout>
    <HorizontalScrollView
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/horiz_curr_list"
        android:scrollbars="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface_curr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioGroup
                android:gravity="start"
                android:layout_gravity="start"
                android:orientation="horizontal"
                android:id="@+id/radiogroup_curr_add"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface5"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="10"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface5_1"
            android:paddingLeft="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:layout_centerHorizontal="true"
            android:paddingStart="10dp">
            <Button
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/btn_cus_det_add1"
                android:background="@drawable/my_border"
                android:paddingLeft="5dp"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="@string/btn_add_close"
                android:layout_below="@+id/edit_cus_gsm"
                android:paddingStart="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface5_2"
            android:paddingLeft="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:layout_centerHorizontal="true"
            android:paddingStart="10dp">
            <Button
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/btn_cus_det_add2"
                android:background="@drawable/my_border"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="@string/btn_add"
                android:layout_below="@+id/edit_cus_gsm"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface7"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="10"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface6_1"
            android:paddingLeft="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:layout_centerHorizontal="true"
            android:paddingStart="10dp">
            <Button
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/btn_cus_det_edit"
                android:background="@drawable/my_border"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:text="@string/btn_add"
                android:layout_weight="2"
                android:layout_below="@+id/edit_cus_gsm"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
