<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/bill_hdr"
        android:background="@drawable/table_row_bg"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/ch_show_all"
                android:paddingRight="70dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-5dp"
                android:layout_marginRight="-5dp"
                android:checked="true"
                android:text="@string/show_all"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_compat"
                android:paddingRight="10dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:textOn="ON"
                android:textOff="OFF"
                android:layout_weight="1"
                app:showText="false"/>
            <TextView
                android:id="@+id/item_status_hdr"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/item_status_new"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioGroup
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/radioGroup_item_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:id="@+id/item_type"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="@string/item_type"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <AutoCompleteTextView
                android:gravity="center"
                android:id="@+id/item_name"
                android:nextFocusLeft="@+id/item_qty"
                android:nextFocusRight="@+id/item_qty"
                android:nextFocusUp="@+id/item_qty"
                android:nextFocusDown="@+id/item_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/item_name"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/item_qty"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="center"
                android:id="@+id/item_weight"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/o_weight"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <EditText
                android:gravity="center"
                android:id="@+id/item_qty"
                android:nextFocusLeft="@+id/item_weight"
                android:nextFocusRight="@+id/item_weight"
                android:nextFocusUp="@+id/item_weight"
                android:nextFocusDown="@+id/item_weight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/o_qty"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/item_weight"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:gravity="center"
                android:id="@+id/bill_save"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_add"
                android:onClick="btn_add_item"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
