<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:paddingRight="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4">
        <TextView
            android:gravity="center"
            android:id="@+id/tr_date"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:hint="2018-01-01"
            android:layout_weight="1"/>
        <AutoCompleteTextView
            android:gravity="right"
            android:id="@+id/tr_name"
            android:nextFocusLeft="@+id/tr_bill_no"
            android:nextFocusRight="@+id/tr_bill_no"
            android:nextFocusUp="@+id/tr_bill_no"
            android:nextFocusDown="@+id/tr_bill_no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/name"
            android:singleLine="true"
            android:layout_weight="3"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_bill_no">
            <requestFocus/>
        </AutoCompleteTextView>
        <TextView
            android:gravity="center"
            android:id="@+id/tr_name_hdr"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/from_branch"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3">
        <AutoCompleteTextView
            android:gravity="right"
            android:id="@+id/to_tr_name"
            android:nextFocusLeft="@+id/tr_bill_no"
            android:nextFocusRight="@+id/tr_bill_no"
            android:nextFocusUp="@+id/tr_bill_no"
            android:nextFocusDown="@+id/tr_bill_no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/name"
            android:singleLine="true"
            android:layout_weight="3"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_bill_no">
            <requestFocus/>
        </AutoCompleteTextView>
        <TextView
            android:gravity="center"
            android:id="@+id/to_tr_name_hdr"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/to_branch"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3">
        <EditText
            android:gravity="right"
            android:id="@+id/tr_remaks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/tr_remarks"
            android:singleLine="true"
            android:layout_weight="2"
            android:imeOptions="actionDone"/>
        <EditText
            android:gravity="right"
            android:id="@+id/tr_bill_no"
            android:nextFocusLeft="@+id/tr_remaks"
            android:nextFocusRight="@+id/tr_remaks"
            android:nextFocusUp="@+id/tr_remaks"
            android:nextFocusDown="@+id/tr_remaks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/no_"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="number"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_remaks"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tr_bill_no_hdr"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:text="@string/bill_no_remarks"/>
    </LinearLayout>
</LinearLayout>
