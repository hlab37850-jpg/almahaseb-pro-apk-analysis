<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingRight="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:onClick="update_bill_total_all"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <View
        android:id="@+id/primerdivisor3"
        android:background="@color/gold"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/LL_discount"
        android:paddingLeft="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/count"
            android:background="@drawable/my_circle"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text=""/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tr_tot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="0"
            android:layout_weight="25"/>
        <TextView
            android:textSize="15dp"
            android:gravity="center"
            android:id="@+id/bill_tot_hdr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/net_hdr"
            android:layout_weight="25"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tr_tot_disc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="0"
            android:layout_weight="25"/>
        <TextView
            android:textSize="15dp"
            android:gravity="center"
            android:id="@+id/bill_tot_hdr_disc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/total_disc_"
            android:layout_weight="25"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:id="@+id/LL_tax"
        android:paddingLeft="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/count2"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text=""/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/bill_tax_amount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="0"
            android:layout_weight="25"
            android:onClick="update_tax_total"/>
        <TextView
            android:textSize="15dp"
            android:gravity="center"
            android:id="@+id/bill_tot_hdr_tax2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/total_tax3"
            android:layout_weight="25"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tr_tax_val"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="0"
            android:drawableRight="@drawable/list2"
            android:layout_weight="20"
            android:onClick="update_tax_total"/>
        <TextView
            android:textSize="15dp"
            android:gravity="center"
            android:id="@+id/bill_tot_hdr_tax"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/total_tax2"
            android:layout_weight="30"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:id="@+id/LL_cost"
        android:paddingLeft="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/count3"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text=""/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tr_bill_tot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="0"
            android:layout_weight="25"/>
        <TextView
            android:textSize="15dp"
            android:gravity="center"
            android:id="@+id/bill_tot_bill_hdr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/weight"
            android:layout_weight="25"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tr_tot_cost"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="0"
            android:layout_weight="25"/>
        <TextView
            android:textSize="15dp"
            android:gravity="center"
            android:id="@+id/bill_tot_hdr_cost"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/total_other_cost2"
            android:layout_weight="25"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="right"
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:id="@+id/paid_amount_input_layout"
        android:paddingLeft="2dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/count4"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text=""/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/remain_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_weight="25"/>
        <TextView
            android:gravity="center"
            android:id="@+id/remain_amount_hdr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/remain_amount"
            android:layout_weight="25"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/paid_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_weight="25"/>
        <TextView
            android:gravity="center"
            android:id="@+id/paid_amount_hdr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/paid_amount2"
            android:layout_weight="25"/>
    </LinearLayout>
</LinearLayout>
