<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <View
        android:id="@+id/primerdivisor3"
        android:background="@color/gold"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/LL_discount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/count"
            android:background="@drawable/my_circle"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text=""/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tr_tot"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="0"
            android:layout_weight="30"
            android:onClick="update_bill_total"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/bill_tot_hdr"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="@string/net_hdr"
            android:layout_weight="20"
            android:onClick="update_bill_total"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tr_tot_disc"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="0"
            android:layout_weight="30"
            android:onClick="update_bill_total"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/bill_tot_hdr_disc"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="@string/total_disc"
            android:layout_weight="20"
            android:onClick="update_bill_total"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/LL_tax"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/tr_bill_tot"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="0"
            android:layout_weight="30"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/bill_tot_bill_hdr"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="@string/total"
            android:layout_weight="20"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/count2"
            android:background="@drawable/my_circle"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text=""/>
        <TextView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/bill_tax_amount"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="0"
            android:layout_weight="20"
            android:onClick="update_tax_total"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tr_tax_val"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="0"
            android:drawableLeft="@drawable/list2"
            android:layout_weight="10"
            android:onClick="update_tax_total"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/bill_tot_hdr_tax"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="@string/total_tax"
            android:layout_weight="20"
            android:onClick="update_tax_total"/>
    </LinearLayout>
</LinearLayout>
