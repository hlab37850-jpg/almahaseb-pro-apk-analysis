<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <LinearLayout
            android:gravity="left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="100">
            <CheckBox
                android:id="@+id/chk_back"
                android:paddingRight="30dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/bill_back"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/item_status_hdr"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/bill_cash"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_compat"
            android:paddingRight="10dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:checked="false"
            android:textOn="ON"
            android:textOff="OFF"
            app:showText="false"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:padding="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4">
        <TextView
            android:gravity="center"
            android:id="@+id/tr_curr_price"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/currency_price"/>
        <TextView
            android:textStyle="bold"
            android:gravity="right"
            android:id="@+id/tv_curr"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/currency"
            android:layout_weight="2.25"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tr_branch"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/branch"
            android:singleLine="true"
            android:layout_weight="1.75"/>
        <TextView
            android:gravity="right"
            android:id="@+id/tv_cash"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:text="@string/cash_account_name"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:paddingRight="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="5">
        <TextView
            android:gravity="left"
            android:id="@+id/tr_date"
            android:paddingLeft="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="2018-01-01"/>
        <AutoCompleteTextView
            android:gravity="right"
            android:id="@+id/tr_name"
            android:nextFocusLeft="@+id/tr_bill_no"
            android:nextFocusRight="@+id/tr_bill_no"
            android:nextFocusUp="@+id/tr_bill_no"
            android:nextFocusDown="@+id/tr_bill_no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/name"
            android:singleLine="true"
            android:layout_weight="5"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_bill_no">
            <requestFocus/>
        </AutoCompleteTextView>
        <TextView
            android:gravity="center"
            android:id="@+id/tr_name_hdr"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="@string/name"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:paddingRight="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3">
        <ImageView
            android:textColor="@android:color/white"
            android:gravity="top"
            android:layout_gravity="top"
            android:id="@+id/btn_attach"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:src="@drawable/camera"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <EditText
            android:gravity="right"
            android:id="@+id/tr_remaks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/tr_remarks"
            android:singleLine="true"
            android:layout_weight="2"
            android:imeOptions="actionDone"/>
        <EditText
            android:gravity="right"
            android:id="@+id/tr_bill_no"
            android:nextFocusLeft="@+id/tr_remaks"
            android:nextFocusRight="@+id/tr_remaks"
            android:nextFocusUp="@+id/tr_remaks"
            android:nextFocusDown="@+id/tr_remaks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/no_"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="number"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_remaks"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tr_bill_no_hdr"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:text="@string/bill_no_remarks"/>
    </LinearLayout>
</LinearLayout>
