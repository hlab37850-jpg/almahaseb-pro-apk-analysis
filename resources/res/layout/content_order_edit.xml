<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:padding="1dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/bill_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/content_bill_del_p1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/content_order_edit_p1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/tr_item_add_hdr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/content_bill_item_add_hdr"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/bill_item_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/report_hdr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/bill_item_det_row_hdr"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/lv_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list_items"
            android:animationCache="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="#00000000"
            android:drawSelectorOnTop="false"
            android:scrollingCache="false"
            android:dividerHeight="0dp"
            android:smoothScrollbar="true"
            android:isScrollContainer="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/bill_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/tr_item_add_hdr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/content_offer_order_summary"/>
    </LinearLayout>
</LinearLayout>
