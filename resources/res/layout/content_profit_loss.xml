<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/bill_hdr3"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:paddingRight="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:gravity="right"
                android:id="@+id/income_hdr"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:hint="@string/income"
                android:layout_weight="1"/>
        </TableRow>
        <View
            android:id="@+id/primerdivisor_1"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <TableRow
            android:gravity="right"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="right"
                android:id="@+id/f1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:id="@+id/sales_tot_hdr"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:hint="@string/sales_total"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="right"
                android:id="@+id/f2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:id="@+id/income_other_hdr"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:hint="@string/other"/>
        </TableRow>
        <View
            android:id="@+id/primerdivisor_2"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textStyle="bold"
                android:gravity="left"
                android:id="@+id/f3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/income_tot_hdr"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:hint="@string/income_tot"/>
        </TableRow>
        <View
            android:id="@+id/primerdivisor_5"
            android:background="@android:color/background_dark"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
    </TableLayout>
    <TableLayout
        android:id="@+id/bill_hdr2"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:paddingRight="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:gravity="right"
                android:id="@+id/outcome_hdr"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:hint="@string/outcome"
                android:layout_weight="1"/>
        </TableRow>
        <View
            android:id="@+id/primerdivisor_3"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <TableRow
            android:gravity="right"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="right"
                android:id="@+id/f4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:id="@+id/supplier_tot_hdr"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:hint="@string/purchase_tot"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="right"
                android:id="@+id/f5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:id="@+id/outcome_other_hdr"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:hint="@string/other"/>
        </TableRow>
        <View
            android:id="@+id/primerdivisor_4"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textStyle="bold"
                android:gravity="left"
                android:id="@+id/f6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/outcome_tot_hdr"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:hint="@string/outcome_tot"/>
        </TableRow>
        <View
            android:id="@+id/primerdivisor_6"
            android:background="@android:color/background_dark"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
    </TableLayout>
    <TableLayout
        android:id="@+id/bill_hdr"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textStyle="bold"
                android:gravity="left"
                android:id="@+id/f7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/net_tot_hdr"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:hint="@string/net_tot"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
