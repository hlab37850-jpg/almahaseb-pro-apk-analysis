<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/bill_hdr"
        android:background="@drawable/table_row_bg"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_compat"
                android:paddingRight="10dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:textOn="ON"
                android:textOff="OFF"
                android:layout_weight="1"
                app:showText="false"/>
            <TextView
                android:id="@+id/item_status_hdr"
                android:visibility="gone"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="@string/item_status_new"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TableRow
            android:gravity="right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/ch_show_all"
                android:paddingRight="70dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-5dp"
                android:layout_marginRight="-5dp"
                android:checked="true"
                android:text="@string/show_all"
                android:layout_weight="0.5"/>
            <TextView
                android:gravity="right"
                android:id="@+id/t_date"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/t_date_hdr"
                android:layout_weight="1"/>
            <TextView
                android:gravity="right"
                android:id="@+id/f_date"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/f_date_hdr"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TableLayout
                android:id="@+id/bill_add_item_sub_hdr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TableRow
                    android:gravity="center_horizontal"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:gravity="center"
                        android:id="@+id/tr_name_add"
                        android:background="@drawable/choose"
                        android:visibility="gone"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:hint="@string/btn_add"/>
                    <AutoCompleteTextView
                        android:gravity="right"
                        android:id="@+id/tr_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/name"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                </TableRow>
            </TableLayout>
            <TextView
                android:gravity="center"
                android:id="@+id/tr_name_hdr"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="@string/supp"/>
        </TableRow>
    </TableLayout>
    <TableLayout
        android:id="@+id/bill_add_item_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
