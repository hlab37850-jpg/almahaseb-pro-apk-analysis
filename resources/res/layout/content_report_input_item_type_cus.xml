<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/bill_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="center_horizontal"
                android:id="@+id/f_date"
                android:background="@drawable/table_row_bg"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/f_date_hdr"
                android:layout_weight="1"/>
        </TableRow>
    </TableLayout>
    <TableLayout
        android:id="@+id/bill_add_item_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="center_horizontal"
                android:id="@+id/t_date"
                android:background="@drawable/table_row_bg"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/t_date_hdr"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="center_horizontal"
                android:id="@+id/item_type"
                android:background="@drawable/table_row_bg"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/item_type"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <AutoCompleteTextView
                android:gravity="center_horizontal"
                android:id="@+id/cus_name"
                android:background="@drawable/table_row_bg"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/cus_name"
                android:singleLine="true"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <AutoCompleteTextView
                android:gravity="center_horizontal"
                android:id="@+id/account_group"
                android:background="@drawable/table_row_bg"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/account_group"
                android:singleLine="true"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <AutoCompleteTextView
                android:gravity="center_horizontal"
                android:id="@+id/account_parent"
                android:background="@drawable/table_row_bg"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/account_parent"
                android:singleLine="true"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <CheckBox
                android:id="@+id/chk_hide"
                android:paddingRight="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/total_per_account"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <CheckBox
                android:id="@+id/chk_hide_parent"
                android:paddingRight="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/total_per_account"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
