<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/bill_hdr"
        android:background="@drawable/table_row_bg"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TableRow
            android:gravity="right"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@android:color/black"
                android:gravity="right"
                android:id="@+id/t_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/t_date_hdr"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@android:color/black"
                android:gravity="right"
                android:id="@+id/f_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/f_date_hdr"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TableLayout
                android:id="@+id/bill_add_item_sub_hdr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TableRow
                    android:gravity="center_horizontal"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:gravity="center"
                        android:id="@+id/tr_name_add"
                        android:background="@drawable/choose"
                        android:visibility="gone"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:hint="@string/btn_add"/>
                    <AutoCompleteTextView
                        android:textColor="@android:color/black"
                        android:gravity="right"
                        android:id="@+id/tr_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/name"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                </TableRow>
            </TableLayout>
            <TextView
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/tr_name_hdr"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="@string/supp"/>
        </TableRow>
    </TableLayout>
    <TableLayout
        android:id="@+id/bill_add_item_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
