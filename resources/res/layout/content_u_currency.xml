<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/edit_cus_interface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">
    <LinearLayout
        android:gravity="right"
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/u_curr_ll"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface5"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="10"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface5_1"
            android:paddingLeft="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:layout_centerHorizontal="true"
            android:paddingStart="10dp">
            <Button
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/btn_cus_det_add1"
                android:background="@drawable/my_border"
                android:paddingLeft="5dp"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="@string/btn_cancel"
                android:layout_below="@+id/edit_cus_gsm"
                android:paddingStart="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface5_2"
            android:paddingLeft="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:layout_centerHorizontal="true"
            android:paddingStart="10dp">
            <Button
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/btn_cus_det_add2"
                android:background="@drawable/my_border"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="@string/save"
                android:layout_below="@+id/edit_cus_gsm"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
