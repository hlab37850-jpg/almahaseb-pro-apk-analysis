<?xml version="1.0" encoding="utf-8"?>
<androidx.percentlayout.widget.PercentRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/primerdivisor1"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TableLayout
        android:id="@+id/item_add_hdr"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="end"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingEnd="10dp">
            <TableLayout
                android:id="@+id/item_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TableRow
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:gravity="top"
                        android:layout_gravity="top"
                        android:id="@+id/tr_type"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/up"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"/>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:id="@+id/edit_tr_amount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_column="1"
                        android:hint="@string/tr_amount"
                        android:layout_weight="1"/>
                </TableRow>
            </TableLayout>
            <TextView
                android:id="@+id/item_name_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="@string/tr_amount2"/>
        </TableRow>
        <TableRow
            android:gravity="end"
            android:id="@+id/tr_curr_view"
            android:paddingRight="10dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/edit_tr_curr_name"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:editable="false"
                android:layout_weight="3"
                android:inputType="date"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/tr_curr_name"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="@string/tr_curr_name"/>
        </TableRow>
        <TableRow
            android:gravity="end"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/edit_tr_date"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/tr_date"
                android:editable="false"
                android:layout_weight="3"
                android:inputType="date"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/tr_date"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="@string/tr_date2"/>
        </TableRow>
        <TableRow
            android:gravity="end"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tr_time"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:editable="false"
                android:layout_weight="3"
                android:inputType="date"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/tr_time_hdr"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="@string/tr_time"/>
        </TableRow>
        <TableRow
            android:gravity="end|center_vertical"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/edit_tr_remarks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/tr_remarks"
                android:layout_weight="1"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/item_weight_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tr_remarks2"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp">
            <ImageView
                android:gravity="top"
                android:layout_gravity="center"
                android:id="@+id/btn_attach"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/camera"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"/>
        </TableRow>
    </TableLayout>
    <View
        android:id="@+id/primerdivisor2"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/item_add_hdr"/>
</androidx.percentlayout.widget.PercentRelativeLayout>
