<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusableInTouchMode="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:id="@+id/cus_id"
                android:visibility="invisible"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:text=" TYPE_"
                android:layout_toRightOf="@+id/cus_phone"
                android:layout_toEndOf="@+id/cus_phone"/>
            <TextView
                android:gravity="center"
                android:id="@+id/cus_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cus_phone"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15dp"
                android:gravity="center"
                android:id="@+id/customer_name"
                android:paddingRight="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cus_name"
                android:layout_weight="2"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:paddingEnd="5dp"
                android:layout_alignParentEnd="true"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
