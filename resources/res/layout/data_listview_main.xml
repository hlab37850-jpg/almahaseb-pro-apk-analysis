<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="100"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <TableLayout
        android:id="@+id/bill_det"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:gravity="right"
            android:paddingTop="0.5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/report_hdr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="10"
                layout="@layout/data_det_row_main_hdr"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="55">
            <LinearLayout
                android:gravity="top"
                android:orientation="vertical"
                android:id="@+id/edit_cus_interface_containter2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="55">
                <include
                    android:id="@+id/report_main"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="55"
                    layout="@layout/data_listview6"/>
            </LinearLayout>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:background="@color/gold2"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="btn_report_4">
            <TextView
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:gravity="right"
                android:id="@+id/tot_net_bal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="0"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tot_net_bal_hdr"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="@string/tot_net_bal"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:background="@color/white"
            android:padding="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="btn_report_5">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/supp_bal_hdr"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:text="@string/supp_bal_hdr"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:background="@color/white"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="btn_report_5">
            <TextView
                android:textSize="15sp"
                android:gravity="right"
                android:id="@+id/tot_price_diff"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tot_price_diff_hdr"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:text="@string/tr_price_dii"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:background="@color/white"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="btn_report_5">
            <TextView
                android:textSize="15sp"
                android:gravity="right"
                android:id="@+id/tot_w21_bal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tot_w21_bal_hdr"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:text="@string/w_21"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:background="@color/white"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="btn_report_5">
            <TextView
                android:textSize="15sp"
                android:gravity="right"
                android:id="@+id/tot_w18_bal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tot_w18_bal_hdr"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:text="@string/w_18"/>
        </TableRow>
        <TableRow
            android:gravity="right"
            android:background="@color/white"
            android:paddingRight="10dp"
            android:paddingBottom="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="btn_report_5">
            <TextView
                android:textSize="15sp"
                android:gravity="right"
                android:id="@+id/tot_w24_bal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="0"
                android:layout_weight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tot_w24_bal_hdr"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:text="@string/w_24"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
