<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/edit_cus_interface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="100">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/edit_cus_header"
        android:background="@color/gold2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2">
        <include
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/report_hdr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/data_det_row_rep3_hdr"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/edit_cus_list_det"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="98"
        android:layout_below="@+id/edit_cus_header"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <ListView
            android:id="@+id/list_items"
            android:animationCache="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="#00000000"
            android:drawSelectorOnTop="false"
            android:scrollingCache="false"
            android:dividerHeight="0dp"
            android:smoothScrollbar="true"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#536fd2"
            android:textColorHighlight="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/emptyResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_list"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/gold2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="130">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:id="@+id/balance2"
            android:padding="5dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="0"
            android:layout_weight="60"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:id="@+id/balance"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="0"
            android:layout_weight="20"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:id="@+id/balance_hdr"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cost_total"
            android:layout_weight="50"/>
    </LinearLayout>
</LinearLayout>
