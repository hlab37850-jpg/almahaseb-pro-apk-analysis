<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_class"
            android:background="@android:color/white"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:src="@drawable/list4"
            android:layout_weight="15"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/cus_group"
            android:background="@drawable/table_row_bg5"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:hint="@string/currency"
            android:singleLine="true"
            android:layout_weight="85"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:gravity="center"
            android:id="@+id/f_date"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="@string/f_date_hdr"
            android:layout_weight="40"/>
        <TextView
            android:gravity="center"
            android:id="@+id/f_date_hdr"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="@string/f_date_hdr"
            android:layout_weight="10"/>
        <EditText
            android:gravity="center"
            android:id="@+id/info_price"
            android:background="@drawable/table_row_bg5"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="@string/currency_price"
            android:singleLine="true"
            android:layout_weight="50"
            android:inputType="numberDecimal"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <EditText
            android:gravity="center"
            android:id="@+id/info_price_sar"
            android:background="@drawable/table_row_bg5"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/curr_price_sar"
            android:singleLine="true"
            android:layout_weight="50"
            android:inputType="numberDecimal"/>
    </LinearLayout>
</LinearLayout>
