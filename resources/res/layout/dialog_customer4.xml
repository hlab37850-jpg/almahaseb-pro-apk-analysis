<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_cus_type"
            android:background="@android:color/white"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:src="@drawable/list4"
            android:layout_weight="15"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/account_type"
            android:nextFocusLeft="@+id/cus_name"
            android:nextFocusRight="@+id/cus_name"
            android:nextFocusUp="@+id/cus_name"
            android:nextFocusDown="@+id/cus_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/account_parent"
            android:singleLine="true"
            android:layout_weight="85"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/cus_name"/>
    </LinearLayout>
    <EditText
        android:gravity="center"
        android:id="@+id/cus_name"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="123"
        android:hint="@string/cus_name"
        android:singleLine="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_call"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/name"
            android:layout_weight="15"/>
        <EditText
            android:gravity="center"
            android:id="@+id/cus_phone"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/cus_phone"
            android:singleLine="true"
            android:layout_weight="85"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_class"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:src="@drawable/list4"
            android:layout_weight="15"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/cus_group"
            android:nextFocusLeft="@+id/cus_addess"
            android:nextFocusRight="@+id/cus_addess"
            android:nextFocusUp="@+id/cus_addess"
            android:nextFocusDown="@+id/cus_addess"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/cus_group"
            android:singleLine="true"
            android:layout_weight="85"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/cus_addess"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <EditText
            android:gravity="center"
            android:id="@+id/cus_vat"
            android:padding="5dp"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/pref_tax_no"
            android:singleLine="true"
            android:layout_weight="40"/>
        <EditText
            android:gravity="center"
            android:id="@+id/cus_addess"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/pref_address"
            android:singleLine="true"
            android:layout_weight="60"/>
    </LinearLayout>
</LinearLayout>
