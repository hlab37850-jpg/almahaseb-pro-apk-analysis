<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_cus_type"
            android:background="@android:color/white"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:src="@drawable/list4"
            android:layout_weight="15"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/account_type"
            android:nextFocusLeft="@+id/cus_name"
            android:nextFocusRight="@+id/cus_name"
            android:nextFocusUp="@+id/cus_name"
            android:nextFocusDown="@+id/cus_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/account_parent"
            android:singleLine="true"
            android:layout_weight="85"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/cus_name"/>
    </LinearLayout>
    <AutoCompleteTextView
        android:gravity="center"
        android:id="@+id/cus_name"
        android:padding="5dp"
        android:nextFocusLeft="@+id/cus_phone"
        android:nextFocusRight="@+id/cus_phone"
        android:nextFocusUp="@+id/cus_phone"
        android:nextFocusDown="@+id/cus_phone"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="@string/account_name"
        android:hint="@string/cus_name"
        android:singleLine="true"
        android:imeOptions="actionNext"
        android:nextFocusForward="@+id/cus_phone"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_call"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/name"
            android:layout_weight="15"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/cus_phone"
            android:padding="5dp"
            android:nextFocusLeft="@+id/cus_group"
            android:nextFocusRight="@+id/cus_group"
            android:nextFocusUp="@+id/cus_group"
            android:nextFocusDown="@+id/cus_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/cus_phone"
            android:singleLine="true"
            android:layout_weight="85"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/cus_group"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_class"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:src="@drawable/list4"
            android:layout_weight="15"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/cus_group"
            android:nextFocusLeft="@+id/cus_addess"
            android:nextFocusRight="@+id/cus_addess"
            android:nextFocusUp="@+id/cus_addess"
            android:nextFocusDown="@+id/cus_addess"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/cus_group"
            android:singleLine="true"
            android:layout_weight="85"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/cus_addess"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:paddingLeft="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pref_address"
            app:boxBackgroundMode="outline"
            app:hintEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:gravity="center"
                android:id="@+id/cus_addess"
                android:nextFocusLeft="@+id/cus_vat"
                android:nextFocusRight="@+id/cus_vat"
                android:nextFocusUp="@+id/cus_vat"
                android:nextFocusDown="@+id/cus_vat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:nextFocusForward="@+id/cus_vat"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:paddingLeft="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pref_tax_no"
            app:boxBackgroundMode="outline"
            app:hintEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:gravity="center"
                android:id="@+id/cus_vat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLength="15"
                android:inputType="number"
                android:imeOptions="actionDone"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="50">
            <CheckBox
                android:id="@+id/chk_wa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/notify_whatsapp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="50">
            <CheckBox
                android:id="@+id/chk_sms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/notify_sms"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
