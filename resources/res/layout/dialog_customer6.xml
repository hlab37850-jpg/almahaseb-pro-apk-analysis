<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/account_name"
            android:background="@drawable/table_row_bg5"
            android:nextFocusLeft="@+id/cus_name"
            android:nextFocusRight="@+id/cus_name"
            android:nextFocusUp="@+id/cus_name"
            android:nextFocusDown="@+id/cus_name"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:hint="@string/br_email"
            android:singleLine="true"
            android:layout_weight="100"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/cus_name"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_cus_type"
            android:background="@android:color/white"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:src="@drawable/list4"
            android:layout_weight="15"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/account_parent"
            android:background="@drawable/table_row_bg5"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/branch"
            android:singleLine="true"
            android:layout_weight="85"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_cash_type"
            android:background="@android:color/white"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:src="@drawable/list4"
            android:layout_weight="15"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/cash_name"
            android:background="@drawable/table_row_bg5"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/cash_account_name"
            android:singleLine="true"
            android:layout_weight="85"/>
    </LinearLayout>
</LinearLayout>
