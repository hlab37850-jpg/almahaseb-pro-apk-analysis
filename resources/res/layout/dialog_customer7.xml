<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/email"
            android:background="@drawable/table_row_bg5"
            android:nextFocusLeft="@+id/cus_name"
            android:nextFocusRight="@+id/cus_name"
            android:nextFocusUp="@+id/cus_name"
            android:nextFocusDown="@+id/cus_name"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="@string/br_email"
            android:singleLine="true"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/cus_name"/>
        <EditText
            android:gravity="center"
            android:id="@+id/msg_text"
            android:background="@drawable/table_row_bg5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/msg_text"
            android:lines="5"
            android:singleLine="false"
            android:maxLength="200"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100"/>
</LinearLayout>
