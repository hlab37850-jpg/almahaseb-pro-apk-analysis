<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="100">
            <AutoCompleteTextView
                android:gravity="center"
                android:id="@+id/cus_name"
                android:background="@drawable/table_row_bg5"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint="@string/cus_name"
                android:singleLine="true"
                android:layout_weight="80"
                android:imeOptions="actionNext"/>
            <TextView
                android:gravity="center"
                android:id="@+id/cus_name_hdr"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/cus_name2"
                android:layout_weight="20"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="100">
            <TextView
                android:gravity="center"
                android:id="@+id/date_"
                android:background="@drawable/table_row_bg5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/tr_date3"
                android:singleLine="true"
                android:layout_weight="80"/>
            <TextView
                android:gravity="center"
                android:id="@+id/date_hdr"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/tr_date3"
                android:layout_weight="20"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="100">
            <TextView
                android:gravity="center"
                android:id="@+id/time_"
                android:background="@drawable/table_row_bg5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/tr_time"
                android:singleLine="true"
                android:layout_weight="80"/>
            <TextView
                android:gravity="center"
                android:id="@+id/time_hdr"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/tr_time"
                android:layout_weight="20"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="100">
            <EditText
                android:gravity="center"
                android:id="@+id/remarks"
                android:background="@drawable/table_row_bg5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/remarks"
                android:lines="2"
                android:singleLine="true"
                android:layout_weight="80"/>
            <TextView
                android:gravity="center"
                android:id="@+id/remarks_hdr"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/remarks"
                android:layout_weight="20"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
