<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@+id/imei_desc2"
        android:background="@android:color/white"
        android:padding="1dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/contact_msg2"
        android:fontFamily="sans-serif"/>
    <View
        android:id="@+id/primerdivisor1"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@+id/imei_desc3"
        android:background="@android:color/white"
        android:padding="1dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/contact_msg3"
        android:fontFamily="sans-serif"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/imei_share"
            android:visibility="gone"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_share"
            android:layout_weight="20"/>
        <Button
            android:textColor="@android:color/black"
            android:gravity="center"
            android:autoLink="all"
            android:id="@+id/imei"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/activation_request_msg"
            android:layout_weight="30"/>
    </LinearLayout>
    <TextView
        android:textColor="@android:color/black"
        android:gravity="center_horizontal"
        android:id="@+id/imei_desc4"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IMEI"
        android:fontFamily="sans-serif"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <EditText
            android:textColorHint="@android:color/darker_gray"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/imei_code"
            android:background="@drawable/table_row_bg"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/imei_code"
            android:singleLine="true"
            android:layout_weight="90"/>
        <View
            android:id="@+id/primerdivisor2"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
    <View
        android:id="@+id/primerdivisor3"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
