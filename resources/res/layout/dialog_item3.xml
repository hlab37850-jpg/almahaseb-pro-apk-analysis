<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="1dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:gravity="center"
        android:id="@+id/info_name"
        android:background="@drawable/table_row_bg5"
        android:nextFocusLeft="@+id/cus_group"
        android:nextFocusRight="@+id/cus_group"
        android:nextFocusUp="@+id/cus_group"
        android:nextFocusDown="@+id/cus_group"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="@string/item_name"
        android:singleLine="true"
        android:imeOptions="actionNext"
        android:nextFocusForward="@+id/cus_group"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:gravity="center"
            android:id="@+id/tr_date"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="2018-01-01"/>
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_class"
            android:background="@android:color/white"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/lists"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/cus_group"
            android:nextFocusLeft="@+id/info_qty"
            android:nextFocusRight="@+id/info_qty"
            android:nextFocusUp="@+id/info_qty"
            android:nextFocusDown="@+id/info_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/item_type"
            android:singleLine="true"
            android:layout_weight="100"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/info_qty"/>
    </LinearLayout>
    <EditText
        android:gravity="center"
        android:id="@+id/info_qty"
        android:padding="5dp"
        android:nextFocusLeft="@+id/info_cost"
        android:nextFocusRight="@+id/info_cost"
        android:nextFocusUp="@+id/info_cost"
        android:nextFocusDown="@+id/info_cost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/o_qty"
        android:singleLine="true"
        android:editable="false"
        android:inputType="numberDecimal"
        android:imeOptions="actionNext"
        android:nextFocusForward="@+id/info_cost"/>
    <EditText
        android:gravity="center"
        android:id="@+id/info_cost"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/o_u_cost"
        android:singleLine="true"
        android:inputType="numberDecimal"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:id="@+id/horiz_curr_list"
            android:scrollbars="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/edit_cus_interface_curr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/radiogroup_curr"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/test1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:button="@null"
                        android:text="ريال"
                        android:drawableRight="@android:drawable/btn_radio"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/test2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:button="@null"
                        android:text="دولار"
                        android:drawableRight="@android:drawable/btn_radio"/>
                </RadioGroup>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
