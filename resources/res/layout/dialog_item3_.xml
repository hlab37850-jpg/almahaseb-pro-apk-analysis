<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="1dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:id="@+id/tr_item_barcode2"
            android:background="@drawable/barcode"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="barcode_click"/>
        <EditText
            android:gravity="center"
            android:id="@+id/info_name"
            android:background="@drawable/table_row_bg5"
            android:nextFocusLeft="@+id/cus_group"
            android:nextFocusRight="@+id/cus_group"
            android:nextFocusUp="@+id/cus_group"
            android:nextFocusDown="@+id/cus_group"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="@string/item_name"
            android:singleLine="true"
            android:layout_weight="1"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/cus_group"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:gravity="center"
            android:id="@+id/tr_date"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="2018-01-01"/>
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_class"
            android:paddingLeft="5dp"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="26dp"
            android:layout_height="20dp"
            android:src="@drawable/list4"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/cus_group"
            android:nextFocusLeft="@+id/info_qty"
            android:nextFocusRight="@+id/info_qty"
            android:nextFocusUp="@+id/info_qty"
            android:nextFocusDown="@+id/info_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/item_type"
            android:singleLine="true"
            android:layout_weight="100"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/info_qty"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <EditText
            android:gravity="center"
            android:id="@+id/info_cost"
            android:background="@drawable/table_row_bg5"
            android:padding="2dp"
            android:nextFocusLeft="@+id/tr_remaks"
            android:nextFocusRight="@+id/tr_remaks"
            android:nextFocusUp="@+id/tr_remaks"
            android:nextFocusDown="@+id/tr_remaks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/o_u_cost"
            android:singleLine="true"
            android:layout_weight="50"
            android:inputType="numberDecimal"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/tr_remaks"/>
        <EditText
            android:gravity="center"
            android:id="@+id/info_qty"
            android:background="@drawable/table_row_bg5"
            android:padding="2dp"
            android:nextFocusLeft="@+id/info_cost"
            android:nextFocusRight="@+id/info_cost"
            android:nextFocusUp="@+id/info_cost"
            android:nextFocusDown="@+id/info_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/o_qty"
            android:singleLine="true"
            android:editable="false"
            android:layout_weight="50"
            android:inputType="numberDecimal"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/info_cost"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/btn_attach4"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/camera"/>
        <TextView
            android:gravity="center"
            android:id="@+id/end_date"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/end_date"
            android:drawableLeft="@drawable/calendar"/>
        <EditText
            android:gravity="center"
            android:id="@+id/tr_remaks"
            android:nextFocusLeft="@+id/unit_name"
            android:nextFocusRight="@+id/unit_name"
            android:nextFocusUp="@+id/unit_name"
            android:nextFocusDown="@+id/unit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tr_remarks"
            android:singleLine="true"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/unit_name"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:gravity="center"
            android:id="@+id/unit_others"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_others"/>
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_class_unit"
            android:paddingLeft="5dp"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/list4"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/unit_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/base_unit"
            android:singleLine="true"
            android:layout_weight="40"
            android:imeOptions="actionDone"/>
        <EditText
            android:gravity="center"
            android:id="@+id/tr_item_barcode_no"
            android:padding="2dp"
            android:visibility="gone"
            android:nextFocusLeft="@+id/unit_name"
            android:nextFocusRight="@+id/unit_name"
            android:nextFocusUp="@+id/unit_name"
            android:nextFocusDown="@+id/unit_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="@string/barcode_no"
            android:singleLine="true"
            android:layout_weight="50"
            android:inputType="number"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/unit_name"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:id="@+id/horiz_curr_list"
            android:scrollbars="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/edit_cus_interface_curr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/radiogroup_curr"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/test1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:button="@null"
                        android:text="ريال"
                        android:drawableRight="@android:drawable/btn_radio"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/test2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:button="@null"
                        android:text="دولار"
                        android:drawableRight="@android:drawable/btn_radio"/>
                </RadioGroup>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
