<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/cus_group"
            android:nextFocusLeft="@+id/cus_phone"
            android:nextFocusRight="@+id/cus_phone"
            android:nextFocusUp="@+id/cus_phone"
            android:nextFocusDown="@+id/cus_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/unit_name"
            android:singleLine="true"
            android:layout_weight="100"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/cus_phone"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <EditText
            android:gravity="center"
            android:id="@+id/cus_phone"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/unit_code"
            android:singleLine="true"
            android:layout_weight="100"/>
    </LinearLayout>
</LinearLayout>
