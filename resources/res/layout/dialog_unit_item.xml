<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_class_item"
            android:background="@android:color/white"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:src="@drawable/list4"
            android:layout_weight="15"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/item_name"
            android:background="@drawable/table_row_bg5"
            android:nextFocusLeft="@+id/unit_name"
            android:nextFocusRight="@+id/unit_name"
            android:nextFocusUp="@+id/unit_name"
            android:nextFocusDown="@+id/unit_name"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:hint="@string/item_name"
            android:singleLine="true"
            android:layout_weight="85"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/unit_name"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_class_unit"
            android:background="@android:color/white"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:src="@drawable/list4"
            android:layout_weight="15"/>
        <AutoCompleteTextView
            android:gravity="center"
            android:id="@+id/unit_name"
            android:background="@drawable/table_row_bg5"
            android:nextFocusLeft="@+id/unit_val"
            android:nextFocusRight="@+id/unit_val"
            android:nextFocusUp="@+id/unit_val"
            android:nextFocusDown="@+id/unit_val"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:hint="@string/unit_name2"
            android:singleLine="true"
            android:layout_weight="85"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/unit_val"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100">
        <TextView
            android:gravity="center"
            android:id="@+id/base_unit"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/base_unit"
            android:layout_weight="30"/>
        <EditText
            android:gravity="center"
            android:id="@+id/unit_val"
            android:background="@drawable/table_row_bg5"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/unit_val"
            android:singleLine="true"
            android:layout_weight="70"
            android:inputType="numberDecimal"/>
    </LinearLayout>
</LinearLayout>
