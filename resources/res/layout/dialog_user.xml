<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="100">
            <EditText
                android:gravity="center"
                android:id="@+id/name"
                android:background="@drawable/table_row_bg5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/cus_name"
                android:singleLine="true"
                android:layout_weight="72"/>
            <TextView
                android:gravity="right"
                android:id="@+id/cus_name_hdr"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/cus_name2"
                android:layout_weight="28"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="100">
            <EditText
                android:gravity="center"
                android:id="@+id/pwd"
                android:background="@drawable/table_row_bg5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/password"
                android:singleLine="true"
                android:layout_weight="70"
                android:inputType="number"/>
            <TextView
                android:gravity="right"
                android:id="@+id/pwd_hdr"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/password"
                android:layout_weight="30"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="100">
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/cash_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/cash_account_name"
                android:singleLine="true"
                android:layout_weight="75"/>
            <TextView
                android:gravity="right"
                android:id="@+id/cash_name_hdr"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cash_name"
                android:layout_weight="25"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="100">
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/branch_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/branch"
                android:singleLine="true"
                android:layout_weight="75"/>
            <TextView
                android:gravity="right"
                android:id="@+id/remarks_hdr"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/branch"
                android:layout_weight="25"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="100">
            <CheckBox
                android:id="@+id/is_active"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/is_active"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
