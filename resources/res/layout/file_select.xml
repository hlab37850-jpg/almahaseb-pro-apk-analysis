<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cus_det"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/edit_cus_interface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="100"
        android:layout_below="@+id/searchButton"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <View
            android:id="@+id/primerdivisor_1"
            android:background="@color/bk_color2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@+id/directoryView"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/edit_cus_list_det"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="95"
            android:layout_below="@+id/edit_cus_header"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true">
            <ListView
                android:id="@+id/directoryView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawSelectorOnTop="false"/>
        </LinearLayout>
        <View
            android:id="@+id/primerdivisor_2"
            android:background="@color/bk_color2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@+id/directoryView"/>
        <LinearLayout
            android:gravity="start"
            android:orientation="horizontal"
            android:id="@+id/edit_cus_interface3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:layout_below="@+id/edit_cus_list_det">
            <TextView
                android:textSize="16dp"
                android:gravity="start"
                android:id="@+id/selectedPath"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="16dp"
                android:gravity="start"
                android:id="@+id/selectedFile"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_gravity="end|top"
        android:id="@+id/fab"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_sort_alphabetically"
        app:backgroundTint="@color/colorPrimary"
        app:fabSize="mini"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
