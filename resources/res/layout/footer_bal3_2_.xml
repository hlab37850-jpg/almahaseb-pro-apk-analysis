<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/linear_footer_bal3_"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:weightSum="100"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/footer_sum3"
            android:background="@color/gold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="..."
            android:layout_weight="50"/>
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/footer_sum2"
            android:background="@color/gold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="..."
            android:layout_weight="50"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/linear_footer_bal4_"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:weightSum="100"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/footer_old_bal"
            android:background="@color/gold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text=""
            android:layout_weight="100"/>
    </LinearLayout>
    <View
        android:id="@+id/primerdivisor2_"
        android:background="@android:color/darker_gray"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="105"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_help"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/whatsapp2"
            android:layout_weight="10"/>
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_call"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/call2_"
            android:layout_weight="10"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/footer_sum"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="65"
            android:layout_below="@+id/primerdivisor"/>
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_fwd_amount"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/tran2_"
            android:layout_weight="10"/>
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_add_amount"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/add2_"
            android:layout_weight="10"/>
    </LinearLayout>
</LinearLayout>
