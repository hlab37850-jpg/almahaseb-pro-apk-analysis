<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/footer_bal"
    android:background="@drawable/table_row_bg_m"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/footer_hdr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_help"
            android:padding="5dp"
            android:visibility="visible"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:src="@drawable/help"
            android:layout_weight="15"
            android:onClick="help_btn"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/footer_sum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="........"
            android:layout_weight="70"
            android:layout_below="@+id/primerdivisor"/>
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_move_tr"
            android:padding="4dp"
            android:clickable="false"
            android:duplicateParentState="false"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:src="@drawable/tran5"
            android:layout_weight="15"
            android:onClick="move_tr_btn"/>
        <ImageView
            android:gravity="center_horizontal"
            android:id="@+id/img_add_amount"
            android:padding="4dp"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:src="@drawable/add2"
            android:layout_weight="15"
            android:onClick="amount_add_btn"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/footer_ads"
        android:background="@android:color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
