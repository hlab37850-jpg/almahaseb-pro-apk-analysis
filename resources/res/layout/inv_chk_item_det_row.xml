<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/bill_items_list_hdr"
        android:background="@android:color/white"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="150"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/diff_qty"
            android:paddingLeft="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/diff_qty"
            android:layout_weight="30"/>
        <TextView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/br_qty"
            android:paddingLeft="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/br_qty"
            android:layout_weight="30"/>
        <TextView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/inv_qty"
            android:paddingLeft="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/inv_qty"
            android:layout_weight="30"/>
        <TextView
            android:textSize="16dp"
            android:gravity="center"
            android:id="@+id/item_unit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/unit"
            android:layout_weight="25"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="right"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="35">
            <TextView
                android:textSize="16dp"
                android:gravity="center"
                android:id="@+id/item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/item"
                android:layout_weight="35"/>
            <TextView
                android:textSize="11dp"
                android:gravity="center"
                android:id="@+id/item_date"
                android:paddingRight="3dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/end_date"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/no_"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:text="ID"/>
    </LinearLayout>
    <View
        android:id="@+id/primerdivisor3"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
