<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="13"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textColor="@android:color/black"
            android:gravity="right"
            android:id="@+id/action_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/type_"
            android:layout_weight="3"
            android:layout_toLeftOf="@+id/customer_name"
            android:layout_toStartOf="@+id/customer_name"/>
        <TextView
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/item_curr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/currency"
            android:layout_weight="3"
            android:layout_toLeftOf="@+id/customer_name"
            android:layout_toStartOf="@+id/customer_name"/>
        <TextView
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/total_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/tr_amount"
            android:layout_weight="3"
            android:layout_toLeftOf="@+id/customer_name"
            android:layout_toStartOf="@+id/customer_name"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="right"
            android:id="@+id/branch_name"
            android:paddingRight="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/branch_name"
            android:layout_weight="4"
            android:layout_alignParentRight="true"
            android:paddingEnd="2dp"
            android:layout_alignParentEnd="true"/>
    </LinearLayout>
</RelativeLayout>
