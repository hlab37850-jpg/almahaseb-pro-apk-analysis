<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface"
        android:background="@android:color/white"
        android:paddingLeft="3dp"
        android:paddingTop="5dp"
        android:paddingRight="5dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="13"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/indicator"
            android:visibility="visible"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/sort_down_"/>
        <TextView
            android:textColor="@android:color/black"
            android:gravity="left"
            android:id="@+id/start_date"
            android:paddingRight="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/start_date"
            android:layout_weight="3.5"/>
        <TextView
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/item_curr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/item_cost_avg_"
            android:layout_weight="2.5"/>
        <TextView
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/item_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sales_price"
            android:layout_weight="3"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="right"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4">
            <TextView
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="right"
                android:id="@+id/item_name"
                android:paddingRight="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/item_name"
                android:layout_alignParentRight="true"
                android:paddingEnd="2dp"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="11dp"
                android:gravity="center"
                android:id="@+id/item_barcode"
                android:paddingRight="3dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/barcode"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/indicator2"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/add5"/>
    </LinearLayout>
</RelativeLayout>
