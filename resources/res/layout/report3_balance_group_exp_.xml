<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_cost_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/item_cost_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_cost_avg"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface"
        android:background="@color/bk_color2"
        android:padding="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="13">
        <TextView
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/start_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/start_date"
            android:layout_weight="4"/>
        <TextView
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/item_curr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/currency"
            android:layout_weight="2"/>
        <TextView
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/item_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/price_unit"
            android:layout_weight="3"
            android:layout_toLeftOf="@+id/customer_name"
            android:layout_toStartOf="@+id/customer_name"/>
        <TextView
            android:textColor="@android:color/black"
            android:gravity="right"
            android:id="@+id/item_name"
            android:paddingRight="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/item_name"
            android:layout_weight="4"
            android:paddingEnd="2dp"/>
    </LinearLayout>
</LinearLayout>
