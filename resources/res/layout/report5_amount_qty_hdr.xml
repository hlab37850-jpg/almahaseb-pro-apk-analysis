<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/edit_cus_interface"
        android:background="@color/gold2"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="12"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/f6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/revenue"
            android:layout_weight="2"
            android:layout_toLeftOf="@+id/customer_name"
            android:layout_toStartOf="@+id/customer_name"/>
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/f5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cost_qty_sales"
            android:layout_weight="2"
            android:layout_toLeftOf="@+id/customer_name"
            android:layout_toStartOf="@+id/customer_name"/>
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/f4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/total_sales"
            android:layout_weight="2"
            android:layout_toLeftOf="@+id/customer_name"
            android:layout_toStartOf="@+id/customer_name"/>
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/f3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/tot_purchase"
            android:layout_weight="2"
            android:layout_toLeftOf="@+id/customer_name"
            android:layout_toStartOf="@+id/customer_name"/>
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/f2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/currency"
            android:layout_weight="2"
            android:layout_toLeftOf="@+id/customer_name"
            android:layout_toStartOf="@+id/customer_name"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="right"
            android:id="@+id/f1"
            android:paddingRight="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/branch"
            android:layout_weight="2"
            android:layout_alignParentRight="true"
            android:paddingEnd="2dp"
            android:layout_alignParentEnd="true"/>
    </LinearLayout>
</RelativeLayout>
