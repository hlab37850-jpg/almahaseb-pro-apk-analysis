<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="end"
    android:orientation="vertical"
    android:id="@+id/edit_cus_interface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="100"
    android:layout_below="@+id/searchButton"
    android:layout_alignParentRight="true"
    android:layout_alignParentEnd="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/edit_cus_header"
        android:background="@drawable/table_row_bg_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2">
        <include
            android:id="@+id/report_hdr"
            layout="@layout/report2_customers_late_hdr"/>
        <View
            android:id="@+id/primerdivisor_1"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/report_hdr"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/edit_cus_list_det"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="95"
        android:layout_below="@+id/edit_cus_header"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <ExpandableListView
            android:id="@+id/list_report"
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/common_action_bar_splitter"
            android:dividerHeight="2dp"/>
        <View
            android:id="@+id/primerdivisor_2"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/list_report"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#536fd2"
            android:textColorHighlight="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/emptyResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_list"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/edit_cus_interface3"
        android:background="@color/bk_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:layout_below="@+id/edit_cus_list_det"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <include
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/report_hdr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/footer_bal_rep1"/>
    </LinearLayout>
</LinearLayout>
