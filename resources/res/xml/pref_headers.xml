<?xml version="1.0" encoding="utf-8"?>
<preference-headers xmlns:android="http://schemas.android.com/apk/res/android">
    <header
        android:icon="@drawable/s_info"
        android:title="@string/pref_header_general"
        android:fragment="info.aalmoghalis.inventory.activity.SettingsActivity$GeneralPreferenceFragment"/>
    <header
        android:icon="@drawable/s_print_option"
        android:title="@string/pref_header_data_sync"
        android:fragment="info.aalmoghalis.inventory.activity.SettingsActivity$DataSyncPreferenceFragment"/>
    <header
        android:icon="@drawable/s_security_option"
        android:id="@+id/security_option"
        android:title="@string/pref_security"
        android:fragment="info.aalmoghalis.inventory.activity.SettingsActivity$SecurityPreferenceFragment"/>
    <header
        android:icon="@drawable/s_security_option"
        android:id="@+id/users"
        android:title="@string/users">
        <intent
            android:targetPackage="info.aalmoghalis.inventory"
            android:action="android.intent.action.VIEW"
            android:targetClass="info.aalmoghalis.inventory.old.Users"/>
    </header>
    <header
        android:icon="@drawable/s_cat"
        android:title="@string/pref_group_curr">
        <intent
            android:targetPackage="info.aalmoghalis.inventory"
            android:action="android.intent.action.VIEW"
            android:targetClass="info.aalmoghalis.inventory.old.GroupList_edit"/>
    </header>
    <header
        android:icon="@drawable/s_g_cat"
        android:title="@string/pref_item_type">
        <intent
            android:targetPackage="info.aalmoghalis.inventory"
            android:action="android.intent.action.VIEW"
            android:targetClass="info.aalmoghalis.inventory.old.itemType_edit"/>
    </header>
    <header
        android:icon="@drawable/s_units"
        android:title="@string/pref_unit">
        <intent
            android:targetPackage="info.aalmoghalis.inventory"
            android:action="android.intent.action.VIEW"
            android:targetClass="info.aalmoghalis.inventory.old.UnitList_edit"/>
    </header>
    <header
        android:icon="@drawable/s_save_option"
        android:title="@string/pref_backup"
        android:fragment="info.aalmoghalis.inventory.activity.SettingsActivity$BackupPreferenceFragment"/> /&gt; 
    <header
        android:icon="@drawable/s_thermal"
        android:title="@string/pref_thermal_options"
        android:fragment="info.aalmoghalis.inventory.activity.SettingsActivity$ThermalPreferenceFragment"/>
    <header
        android:icon="@drawable/s_tax"
        android:title="@string/tax_setting">
        <intent
            android:targetPackage="info.aalmoghalis.inventory"
            android:action="android.intent.action.VIEW"
            android:targetClass="info.aalmoghalis.inventory.old.Tax_edit"/>
    </header>
    <header
        android:icon="@drawable/s_tax"
        android:title="@string/zatca_setting">
        <intent
            android:targetPackage="info.aalmoghalis.inventory"
            android:action="android.intent.action.VIEW"
            android:targetClass="info.aalmoghalis.inventory.zatca.ZatcaSettingsActivity"/>
    </header>
    <header
        android:icon="@drawable/s_thermal"
        android:title="@string/barcode_option"
        android:fragment="info.aalmoghalis.inventory.activity.SettingsActivity$BarcodePreferenceFragment"/> /&gt; 
    <header
        android:icon="@drawable/s_ther_remarks"
        android:title="@string/pref_SMS_WA_options"
        android:fragment="info.aalmoghalis.inventory.activity.SettingsActivity$SMS_WA_PreferenceFragment"/> /&gt; 
    <header
        android:icon="@drawable/s_other_option"
        android:title="@string/pref_other_options"
        android:fragment="info.aalmoghalis.inventory.activity.SettingsActivity$OthersPreferenceFragment"/> /&gt; 
    <header
        android:icon="@drawable/s_name"
        android:id="@+id/check_activation">
        <intent
            android:targetPackage="info.aalmoghalis.inventory"
            android:action="android.intent.action.VIEW"
            android:targetClass="info.aalmoghalis.inventory.activity.activationActivity"/>
    </header>
    <header
        android:icon="@drawable/s_node"
        android:id="@+id/nodjs_option"
        android:title="@string/pref_online">
        <intent
            android:targetPackage="info.aalmoghalis.inventory"
            android:action="android.intent.action.VIEW"
            android:targetClass="info.aalmoghalis.inventory.fcm.online_status"/>
    </header>
</preference-headers>
